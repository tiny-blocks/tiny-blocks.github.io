---
/**
 * The bar on top of every page: the brand that leads home, the way to search, the organization on GitHub and
 * on Packagist, and the theme control.
 */
import { SITE, TEXT } from '../content/site'
import BrandMark from './BrandMark.astro'
import Icon from './Icon.astro'
import ThemeToggle from './ThemeToggle.astro'
---

<header class="tb-bar">
  <div class="tb-wrap tb-bar__inner">
    <a href="/" class="tb-home" aria-label={`${SITE.name}: ${TEXT.nav.home}`}>
      <BrandMark label={SITE.name} />
    </a>
    <div class="tb-bar__controls">
      <div class="tb-bar__tools">
        <a href="/search/" class="tb-bar__tool" aria-label={TEXT.nav.search} title={TEXT.nav.search}>
          <Icon name="search" size={18} />
        </a>
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer"
          class="tb-bar__tool"
          aria-label={TEXT.nav.source}
          title={TEXT.nav.source}
        >
          <Icon name="github" size={18} />
        </a>
        <a
          href={SITE.packagist}
          target="_blank"
          rel="noopener noreferrer"
          class="tb-bar__tool"
          aria-label={TEXT.nav.packagist}
          title={TEXT.nav.packagist}
        >
          <Icon name="packagist" size={18} />
        </a>
      </div>
      <ThemeToggle theme={TEXT.theme} />
    </div>
  </div>
</header>
