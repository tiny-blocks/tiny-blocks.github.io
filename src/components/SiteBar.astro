---
/**
 * The bar on top of every page: the brand that leads home, the search, which opens as a dialog over the page
 * and is a link to the search page where no script runs, the organization on GitHub and on Packagist, and
 * the theme control.
 */
import { SITE, TEXT } from '../content/site'
import BrandMark from './BrandMark.astro'
import Icon from './Icon.astro'
import SearchForm from './SearchForm.astro'
import ThemeToggle from './ThemeToggle.astro'
---

<header class="tb-bar">
  <div class="tb-wrap tb-bar__inner">
    <a href="/" class="tb-home" aria-label={`${SITE.name}: ${TEXT.nav.home}`}>
      <BrandMark label={SITE.name} />
    </a>
    <div class="tb-bar__controls">
      <div class="tb-bar__tools">
        <a
          href="/search/"
          class="tb-bar__tool tb-bar__tool--search"
          aria-label={TEXT.nav.search}
          title={TEXT.nav.search}
          aria-haspopup="dialog"
          data-search-open
        >
          <Icon name="search" size={18} />
          <span aria-hidden="true">{TEXT.nav.search}</span>
          <kbd aria-hidden="true">{TEXT.search.shortcut}</kbd>
        </a>
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer"
          class="tb-bar__tool"
          aria-label={TEXT.nav.source}
          title={TEXT.nav.source}
        >
          <Icon name="github" size={18} />
        </a>
        <a
          href={SITE.packagist}
          target="_blank"
          rel="noopener noreferrer"
          class="tb-bar__tool"
          aria-label={TEXT.nav.packagist}
          title={TEXT.nav.packagist}
        >
          <Icon name="packagist" size={18} />
        </a>
      </div>
      <ThemeToggle theme={TEXT.theme} />
    </div>
  </div>
</header>

<dialog class="tb-dialog" aria-label={TEXT.search.title} closedby="any" data-search-dialog>
  <div class="tb-dialog__head">
    <p class="tb-dialog__title">{TEXT.search.title}</p>
    <form method="dialog">
      <button type="submit" class="tb-bar__tool" aria-label={TEXT.search.close} title={TEXT.search.close}>
        <span aria-hidden="true">✕</span>
      </button>
    </form>
  </div>
  <SearchForm id="search-dialog-term" autofocus />
</dialog>
