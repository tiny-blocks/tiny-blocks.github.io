---
/** The page GitHub Pages answers with for any address that publishes nothing. */
import { MAIN_ID, TEXT } from '../content/site'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title={TEXT.notFound.title} path={null}>
  <main id={MAIN_ID} class="tb-wrap tb-lost">
    <p class="tb-lost__code" aria-hidden="true">404</p>
    <h1 class="tb-cover__title">{TEXT.notFound.title}</h1>
    <p class="tb-cover__lede">{TEXT.notFound.lede}</p>
    <a href="/" class="tb-button tb-button--primary">{TEXT.notFound.back}</a>
  </main>
</BaseLayout>
